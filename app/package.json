{
  "name": "kdna-demo-web-viewer",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/start-local.mjs --dev",
    "build": "next build --webpack",
    "start": "node scripts/start-local.mjs",
    "test": "node scripts/check-basic.mjs && node --unhandled-rejections=strict --test tests/repository-contract.test.mjs tests/pd300-basic.test.mjs",
    "test:e2e": "playwright test",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "public:check": "node scripts/check-public-surface.mjs",
    "public:check:source": "node scripts/check-public-surface.mjs --allow-missing-lock",
    "release:context": "node scripts/verify-release-context.mjs",
    "ci": "npm run test && npm run public:check && npm run audit:production && npm run build && npm run test:e2e",
    "check:basic": "node scripts/check-basic.mjs",
    "fixtures": "node tests/pd300-fixtures.mjs"
  },
  "dependencies": {
    "@aikdna/kdna-core": "file:vendor/aikdna-kdna-core-0.24.0-rc.component-semantics.2.tgz",
    "@aikdna/kdna-read": "file:vendor/aikdna-kdna-read-0.3.0-rc.component-semantics.2.tgz",
    "@aikdna/kdna-web-client": "file:vendor/aikdna-kdna-web-client-0.5.0-rc.component-semantics.1.tgz",
    "@aikdna/kdna-react": "file:vendor/aikdna-kdna-react-0.6.0-rc.component-semantics.1.tgz",
    "next": "16.3.5",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "cbor-x": "1.6.5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.4"
  }
}
