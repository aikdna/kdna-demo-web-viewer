# Configure these in the shell that launches npm start; the owner starts both processes.
# Ports must be distinct, unused, and are always bound to 127.0.0.1.
KDNA_DEMO_PORT=3210
KDNA_DEMO_HOST_PORT=3211
# Local operator policy; deny and transport are explicit negative-test modes.
KDNA_DEMO_POLICY=allow
KDNA_DEMO_DELAY_MS=0
# The internal token is generated at startup. Never put it in NEXT_PUBLIC variables.
